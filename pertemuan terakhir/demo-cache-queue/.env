# Port di host untuk tiap service. Dipakai docker compose secara otomatis.
# Semua di rentang belasan ribu supaya tidak bentrok dengan Redis/RabbitMQ/
# web server yang biasanya sudah jalan di laptop.
#
# Dashboard  : http://localhost:18000
# Management : http://localhost:25673  (guest / guest)
# Redis host : localhost:16380         (di dalam container tetap 6379)
# AMQP host  : localhost:15673         (di dalam container tetap 5672)
BACKEND_HOST_PORT=18000
REDIS_HOST_PORT=16380
AMQP_HOST_PORT=15673
MGMT_HOST_PORT=25673
